FROM golang:1.25 AS build

WORKDIR /src

ARG TARGETOS
ARG TARGETARCH

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -trimpath -ldflags="-s -w" -o /out/recipes-web ./cmd/recipes-web

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /out/recipes-web /recipes-web

# No data is baked in: the repo is the database, and it is mounted at runtime
# by a git-sync sidecar (see deploy/recipes-web.example.yaml). The deployment
# sets RECIPES_ROOT to the synced working tree.
ENV ADDR=:8080

EXPOSE 8080
ENTRYPOINT ["/recipes-web"]
