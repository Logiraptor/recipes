FROM golang:1.25 AS build

WORKDIR /src

ARG TARGETOS
ARG TARGETARCH

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -trimpath -ldflags="-s -w" -o /out/recipes-web ./cmd/recipes-web

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /out/recipes-web /recipes-web

# The repo is the database: bake the data in and point the server at it.
COPY recipes /data/recipes
COPY meal-plans /data/meal-plans
ENV RECIPES_ROOT=/data
ENV ADDR=:8080

EXPOSE 8080
ENTRYPOINT ["/recipes-web"]
